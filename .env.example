# mud.ren 中文社区知识库配置
# 已有部署请合并新增配置项，保留自己的密钥和数据库设置。
# 为兼容 docker run --env-file，使用不带外围引号的 KEY=value 格式。
# 注释请单独成行；修改配置后需要重启 API。

# API 监听地址与端口；修改后重启服务。HOST 不要填写 http:// 或端口。
# 0.0.0.0 表示监听全部 IPv4 网卡；只允许本机访问时改为 127.0.0.1。
HOST=0.0.0.0
PORT=8008

# 必填密钥：Dify 使用前者访问本服务，向量与重排模型共用后者。
DIFY_API_KEY=your_dify_api_key_here
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here

# 向量与重排模型配置。
# 切换向量模型或维度后需先同步数据，再重启 API；仅切换重排模型无需重建索引。
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 是否启用模型重排；候选数默认 20，实际至少为请求的 top_k；超时单位为秒。
RERANK_ENABLED=true
RERANK_CANDIDATES=20
RERANK_TIMEOUT=30

# 混合检索：向量召回 + 本地 BM25，通过 RRF 融合后按需进行模型重排。
# 旧索引启用 BM25 前需同步一次；start_server.bat 会在启动 API 前自动同步。
# 同步始终生成两路索引，BM25_ENABLED 只控制查询阶段。
BM25_ENABLED=true
# 两路召回窗口默认均为 20；RRF_K 为排名平滑常数，详见 README。
BM25_CANDIDATES=20
VECTOR_CANDIDATES=20
RRF_K=60

# 与 Dify 配置的“外部知识库 ID”一致。
# 留空兼容旧版行为：同一份索引接受任意非空知识库 ID。
KNOWLEDGE_ID=mud-ren-forum

# 数据目录：相对于项目根目录的路径，也可填写绝对路径。
DATA_DIR=data

# mud.ren 论坛正文接口与引用链接地址，HTTPS 证书校验始终开启。
FORUM_API_BASE_URL=https://api.mud.ren
FORUM_BASE_URL=https://bbs.mud.ren
# 正文请求超时秒数，以及每个服务进程的正文请求并发上限。
HTTP_TIMEOUT=15
FETCH_CONCURRENCY=5
# 已发布索引的检查间隔（秒），不是数据库同步间隔。
# 启动脚本同步一次；服务运行期间的定期同步需另行配置计划任务。
INDEX_RELOAD_INTERVAL=5

# 论坛 MySQL 配置，仅同步脚本使用；自动启动流程会先执行同步。
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database_name
