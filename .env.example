# Merge new settings into existing deployments; keep your own credentials.
# Use KEY=value without surrounding quotes for docker run --env-file.
# Put comments on separate lines. Restart the API after changing settings.

# Required API credentials
DIFY_API_KEY=your_dify_api_key_here
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here

# Model configuration (both services use DASHSCOPE_API_KEY)
# Changing the embedding model/dimension requires sync, then an API restart.
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_ENABLED=true
RERANK_CANDIDATES=20
RERANK_TIMEOUT=30

# Hybrid retrieval: vector + local BM25, followed by RRF and optional reranking
# Run python scripts/sync_data.py once before enabling BM25 on an old index.
# Synchronization always builds both indexes; BM25_ENABLED affects queries only.
BM25_ENABLED=true
BM25_CANDIDATES=20
VECTOR_CANDIDATES=20
RRF_K=60

# Must match the external knowledge ID configured in Dify.
# Leave empty to preserve legacy behavior (accept any ID for the single index).
KNOWLEDGE_ID=mud-ren-forum

# Paths relative to the project directory, or absolute paths
DATA_DIR=data

# Forum API and citation URLs; HTTPS certificate verification stays enabled
FORUM_API_BASE_URL=https://api.mud.ren
FORUM_BASE_URL=https://bbs.mud.ren
HTTP_TIMEOUT=15
FETCH_CONCURRENCY=5
# Index reload checks published files; database synchronization must be scheduled separately.
INDEX_RELOAD_INTERVAL=5

# MySQL connection (used by the synchronization script only)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database_name
